# libpdx-audit — caps.decl
#
# Wave: R49
# Doc:  design/tooling/r49-r50-plan.md §3.4 in the paideia-os repo.
#
# libpdx-audit is a shared userspace library that emits an audit event
# to the well-known service `svc.audit-journal` before its consumer
# emits any user-visible output (D3 audit-first, paideia-os plan §1).
#
# The library itself performs TWO syscalls of its own:
#
#   * `sys_svc_lookup(name_ptr, name_len)` (SC+ ID 43) — resolves
#     "svc.audit-journal" to a fresh KIND_IPC_ENDPOINT cap slot in the
#     caller's cap_table. The kernel handler mints the slot; the caller
#     must hold enough cap-table space for one slot.
#
#   * `sys_ipc_send(cap_slot, hdr_va, payload_va, payload_len)`
#     (SC+ ID 42) — publishes the completed audit record to the slot
#     minted above. Send-side rights derive from the broker row's
#     rights_gate at registration time; libpdx-audit inherits whatever
#     the broker chose.
#
# `sys_svc_lookup` is gated on the caller having sufficient authority
# to consume a name from the R20b broker table (there is no per-name
# access control at R20b — the broker is a shared namespace); the
# resolved slot then carries its own WRITE/INVOKE rights per the
# `svc.audit-journal` registration. Consumers therefore do NOT need to
# grant libpdx-audit any additional caps beyond the ambient cap-table
# space and the (soon-to-be) `KIND_IPC_ENDPOINT(write, svc.audit-journal)`
# grant that the broker mints on lookup.
#
# The library also references its consumers' argv memory (op_name /
# op_args pointers threaded through audit_begin) but never mutates it —
# unlike libpdx-argv which mutates argv in place on `--foo=bar`.
requires: KIND_IPC_ENDPOINT(write, svc.audit-journal) via svc_lookup

# Declared output schemas — PdxAuditRecord@0.2 (libpdx-audit#11 + #12,
# shipped as one coordinated wire revision; supersedes the M3-002
# PdxAuditRecord@0.1 fixed 64-byte / eight-u64-word record). @0.2 is a
# 256-byte hybrid record: five u64 numeric words (audit_id, event_kind,
# exit_code, parent_audit_id, output_hash) at offsets 0/8/16/24/32,
# followed by three fixed-size inline NUL-terminated string fields
# (op_name[32], op_args[128], output_schema[32]) at offsets 40/72/200,
# and 24 reserved bytes at offset 232 (see design/architecture.md §2
# + §12.6). Two independent fixes landed together because both change
# the record shape and both change AUDIT_HDR_WORD / AUDIT_PAYLOAD_BYTES:
#
#   * #11 — @0.1 sent record_op_name_ptr / record_op_args_ptr /
#     record_output_schema_ptr verbatim: live VAs meaningful only in
#     the SENDING process's address space, so the audit-journal daemon
#     (a different process) received opaque integers where readable
#     text belonged. @0.2 inlines the actual string bytes instead.
#   * #12 — @0.1's record_audit_id was a bare per-process monotonic
#     counter, so every tool's first audit had audit_id == 1 — the
#     M3-002 parent-linkage feature broke the moment two sibling
#     processes each opened their first audit. @0.2 composes
#     audit_id as `(pid << 32) | local_id`, making it globally unique.
#
# Every lifecycle send discriminates on event_kind at offset 8:
# UEJ_KIND_TOOL_INVOKE (130), TOOL_OUTPUT (132), TOOL_EXIT (133) —
# landed at M2-001 / M3-002, unchanged by @0.2.
declares_output_schemas:
  - PdxAuditRecord@0.2

# Wire ownership — ENH-007, updated for @0.2. `svc.audit-journal` is a
# single shared broker endpoint; every producer that sends to the cap
# slot resolved by `sys_svc_lookup("svc.audit-journal")` MUST frame its
# payload with AUDIT_HDR_WORD (0x0000_0100_0000_0220 — op 0x20
# AUDIT_EVENT, ver 2, reply_ep 0, payload_len 256) and MUST marshal the
# 256-byte PdxAuditRecord@0.2 layout byte-for-byte (design/
# architecture.md §2 + §12.6). There is no per-producer discriminator
# on this endpoint at R49 — a second producer framing a different-
# shaped payload (e.g. a caller with its own hand-rolled svc_lookup/
# ipc_send trampolines instead of linking this library) puts an
# undecodable record on the wire the moment a real audit-journal daemon
# body lands. libpdx-audit is the **only** sanctioned producer
# implementation of this frame; any consumer emitting audit events to
# this broker name must link this library rather than reimplementing
# the wire format locally.
wire_ownership:
  endpoint: svc.audit-journal
  frame_header: AUDIT_HDR_WORD
  record_schema: PdxAuditRecord@0.2
