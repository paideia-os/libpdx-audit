# libpdx-audit — caps.decl
#
# Wave: R49
# Doc:  design/tooling/r49-r50-plan.md §3.4 in the paideia-os repo.
#
# libpdx-audit is a shared userspace library that emits an audit event
# to the well-known service `svc.audit-journal` before its consumer
# emits any user-visible output (D3 audit-first, paideia-os plan §1).
#
# The library itself performs TWO syscalls of its own:
#
#   * `sys_svc_lookup(name_ptr, name_len)` (SC+ ID 43) — resolves
#     "svc.audit-journal" to a fresh KIND_IPC_ENDPOINT cap slot in the
#     caller's cap_table. The kernel handler mints the slot; the caller
#     must hold enough cap-table space for one slot.
#
#   * `sys_ipc_send(cap_slot, hdr_va, payload_va, payload_len)`
#     (SC+ ID 42) — publishes the completed audit record to the slot
#     minted above. Send-side rights derive from the broker row's
#     rights_gate at registration time; libpdx-audit inherits whatever
#     the broker chose.
#
# `sys_svc_lookup` is gated on the caller having sufficient authority
# to consume a name from the R20b broker table (there is no per-name
# access control at R20b — the broker is a shared namespace); the
# resolved slot then carries its own WRITE/INVOKE rights per the
# `svc.audit-journal` registration. Consumers therefore do NOT need to
# grant libpdx-audit any additional caps beyond the ambient cap-table
# space and the (soon-to-be) `KIND_IPC_ENDPOINT(write, svc.audit-journal)`
# grant that the broker mints on lookup.
#
# The library also references its consumers' argv memory (op_name /
# op_args pointers threaded through audit_begin) but never mutates it —
# unlike libpdx-argv which mutates argv in place on `--foo=bar`.
requires: KIND_IPC_ENDPOINT(write, svc.audit-journal) via svc_lookup

# Declared output schemas — PdxAuditRecord@0.1 is the fixed 64-byte
# / eight-u64-word record landed at M3-002 (grew from the M1 stub's
# 56 bytes to carry parent_audit_id at index [7]; see
# design/architecture.md §2). Every lifecycle send discriminates on
# event_kind at index [1]: UEJ_KIND_TOOL_INVOKE (130), TOOL_OUTPUT
# (132), TOOL_EXIT (133) — landed at M2-001 / M3-002, not merely
# planned.
declares_output_schemas:
  - PdxAuditRecord@0.1

# Wire ownership — ENH-007. `svc.audit-journal` is a single shared
# broker endpoint; every producer that sends to the cap slot resolved
# by `sys_svc_lookup("svc.audit-journal")` MUST frame its payload with
# AUDIT_HDR_WORD (0x0000_0040_0000_0120 — op 0x20 AUDIT_EVENT, ver 1,
# reply_ep 0, payload_len 64) and MUST marshal the eight-u64
# PdxAuditRecord@0.1 layout byte-for-byte (design/architecture.md §2).
# There is no per-producer discriminator on this endpoint at R49 — a
# second producer framing a different-shaped payload (e.g. a caller
# with its own hand-rolled svc_lookup/ipc_send trampolines instead of
# linking this library) puts an undecodable record on the wire the
# moment a real audit-journal daemon body lands. libpdx-audit is the
# **only** sanctioned producer implementation of this frame; any
# consumer emitting audit events to this broker name must link this
# library rather than reimplementing the wire format locally.
wire_ownership:
  endpoint: svc.audit-journal
  frame_header: AUDIT_HDR_WORD
  record_schema: PdxAuditRecord@0.1
