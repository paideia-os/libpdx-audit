// tests/test_append_leaf.pdx — libpdx-audit.LE.M2-002 (#31)
// Driver for AuditClient::audit_append_leaf — the thin `!{mem}`-only
// leaf primitive that unblocks paideia-os/libpdx-elevate#38 (LE.M2-002)
// without propagating the widened `!{mem, sysreg} @{cap, sched}` tail
// the full audit_begin/_record_output/_commit trio carries. See
// src/audit_client.pdx's own doc comment for the full design rationale
// (why this leaf stages into AuditRecord::audit_leaf_scratch instead of
// calling AuditBroker::audit_send_record / sys_ipc_send).
//
// Return convention (identical to every M4 test driver in this repo):
//
//   0                       — all subtests passed.
//   1..N (small u64)         — failing subtest ordinal.
//
// Effects `!{mem} @{}` — every callee here (AuditRecord::reset,
// AuditClient::audit_append_leaf) is a pure .bss read/write leaf. No
// syscall anywhere in this driver.
//
// Cross-module functions called:
//   AuditRecord::reset          (src/audit_record.pdx)
//   AuditClient::audit_append_leaf (src/audit_client.pdx, LE.M2-002 #31)
// Cross-module .bss symbols read/written:
//   audit_broker_slot           (src/audit_record.pdx — fault-injected
//                                 to exercise every sink-availability
//                                 branch)
//   audit_leaf_pending          (src/audit_record.pdx)
//   audit_leaf_scratch_len      (src/audit_record.pdx)
//   audit_leaf_scratch          (src/audit_record.pdx — byte-compared
//                                 against the fixture below)

module TestAppendLeaf = structure {

  // ============================================================================
  // Fixture: a 64-byte caller-composed "record" with a recognizable
  // repeating pattern (`"LEAFTEST"` x8) so a byte-for-byte compare
  // against AuditRecord::audit_leaf_scratch after a successful
  // audit_append_leaf call can catch any off-by-one, truncation, or
  // enrichment (this leaf MUST NOT alter the caller's bytes in any way).
  // Well inside [AUDIT_LEAF_MIN_BYTES=16, AUDIT_LEAF_MAX_BYTES=128].
  // ============================================================================
  pub let tal_valid_record : [u8; 64] =
    "LEAFTESTLEAFTESTLEAFTESTLEAFTESTLEAFTESTLEAFTESTLEAFTESTLEAFTEST"

  // ============================================================================
  // test_append_leaf_run() -> u64
  //
  // Subtest ledger:
  //
  //   1  buffer_ptr == 0 -> AUDIT_LEAF_ERR_NULL_BUFFER (-1), regardless
  //      of sink state (reset() just ran, slot is UNRESOLVED).
  //   2  buffer_len == 15 (< AUDIT_LEAF_MIN_BYTES) -> AUDIT_LEAF_ERR_
  //      BAD_LENGTH (-2).
  //   3  buffer_len == 129 (> AUDIT_LEAF_MAX_BYTES) -> AUDIT_LEAF_ERR_
  //      BAD_LENGTH (-2).
  //   4  valid ptr/len, audit_broker_slot still AUDIT_BROKER_SLOT_
  //      UNRESOLVED (0xFFFF, reset()'s own sentinel) -> AUDIT_LEAF_ERR_
  //      SINK_UNAVAILABLE (-3) — fail-close, no bind attempted.
  //   5  valid ptr/len, audit_broker_slot fault-injected to 0 (.bss-
  //      zero — the state a consumer that never called audit_broker_
  //      bind observes) -> AUDIT_LEAF_ERR_SINK_UNAVAILABLE (-3).
  //   6  valid ptr/len, audit_broker_slot fault-injected to a valid
  //      kernel cap slot (5) -> AUDIT_OK (0); audit_leaf_pending == 1;
  //      audit_leaf_scratch_len == 64; audit_leaf_scratch[0..64) equals
  //      tal_valid_record byte-for-byte (no enrichment); audit_leaf_
  //      scratch[64..128) is zero-padded.
  //   7  valid ptr, len == 32, audit_broker_slot fault-injected to the
  //      AuditBrokerSatellite sentinel (0xFFFE) -> AUDIT_OK (0);
  //      audit_leaf_scratch_len == 32 — proves the satellite-bound slot
  //      is also treated as "available".
  //
  // Register plan (single leaf-of-leaves; every callee is a pure leaf
  // so r12/r13 stay unused, pushed only for SysV callee-save + rsp %
  // 16 alignment parity across every nested call, matching every other
  // driver in this tree):
  //   rax = call returns / .bss loads / byte scratch
  //   rcx = byte-compare loop index (subtest 6 only)
  //   rdx = byte-compare scratch (subtest 6 only)
  //   r8  = expected-bytes cursor (subtest 6 only)
  //   r9  = actual-bytes cursor (subtest 6 only)
  //   r11 = LEA scratch (paideia-as reserved)
  //   r12/r13 = alignment pair, unused otherwise
  // ============================================================================

  pub let test_append_leaf_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-audit.LE.M2-002 (#31): TestAppendLeaf::test_append_leaf_run entry point. Seven-subtest sequential driver over AuditClient::audit_append_leaf, exercising every gate documented on the function: subtest 1 passes a null buffer_ptr (xor rdi,rdi) and expects AUDIT_LEAF_ERR_NULL_BUFFER (-1) regardless of sink state, proving gate 1 runs before gate 3 (no sink probe happens on a null buffer). Subtests 2+3 pass a valid non-null buffer_ptr with buffer_len 15 and 129 respectively (one below AUDIT_LEAF_MIN_BYTES=16, one above AUDIT_LEAF_MAX_BYTES=128) and expect AUDIT_LEAF_ERR_BAD_LENGTH (-2) both times, proving the length gate is inclusive-bounded on both ends (16 and 128 themselves are legal, only tested as the boundary the OTHER two subtests sit one unit outside of). Subtest 4 uses a valid ptr/len pair but leaves audit_broker_slot at reset()'s own AUDIT_BROKER_SLOT_UNRESOLVED (0xFFFF) sentinel, expecting AUDIT_LEAF_ERR_SINK_UNAVAILABLE (-3) — the fail-close-without-blocking path, since audit_append_leaf never calls audit_broker_bind to try to resolve it. Subtest 5 fault-injects audit_broker_slot=0 (.bss-zero, the state a consumer that never called audit_broker_bind at all observes — distinct from reset()'s explicit UNRESOLVED write) and expects the same -3, proving both 'never touched' and 'explicitly marked unresolved' fail closed identically. Subtest 6 fault-injects a valid kernel cap slot (5, chosen arbitrarily inside [1..255]) and expects AUDIT_OK (0), then verifies three postconditions: audit_leaf_pending reads 1, audit_leaf_scratch_len reads 64 (the buffer_len passed), and a 64-byte compare loop (tal_cmp6_loop, r8=expected cursor into tal_valid_record, r9=actual cursor into audit_leaf_scratch, rcx=index, byte-walked via `add reg,1` per iteration — never indexed addressing, sidestepping SIB U1606 per the audit_marshal_string precedent) confirms every byte was copied verbatim with zero enrichment, followed by a second loop (tal_pad6_loop) continuing rcx from 64 to 128 confirming every byte of audit_leaf_scratch past the accepted length is zero-padded. Subtest 7 fault-injects the AuditBrokerSatellite sentinel (0xFFFE, src/audit_broker_satellite.pdx AUDIT_BROKER_SLOT_SATELLITE) with a different valid length (32, inside [16,128] but distinct from subtest 6's 64) and expects AUDIT_OK (0) plus audit_leaf_scratch_len==32, proving a satellite-bound process is also treated as 'sink available' by the same gate-3 range check that accepts a kernel slot. Every callee (reset, audit_append_leaf) is a pure `!{mem} @{}` leaf so r12/r13 are pushed once at entry purely for SysV callee-save + rsp % 16 alignment parity across the run of nested calls, matching test_broker_refusal_run's and test_replay_golden_run's own shape, and popped before every return. Label prefix tal_ per the project reserved-label discipline (bare 'ok'/'done'/'fail'/'loop' collide with paideia-as keywords). Return code: 0 on all-pass, 1..7 = ordinal of the first failing subtest. No test mnemonic; every zero-check is cmp reg, 0. No `and`; the three negative expected-return comparisons use `cmp rax, 0xFFFFFFFFFFFFFFFF/FE/FD` directly — all three sign-extend cleanly from their low 32 bits, matching the cmp-against-negative-hex-constant precedent already used throughout paideia-os (e.g. src/kernel/core/net/dns.pdx:521 `cmp rax, 0xFFFFFFFFFFFFFFDF`). No `add reg, [mem]` anywhere. Immediates: 0 (AUDIT_OK / bss-zero fault-inject / byte-compare zero-check / ordinal-adjacent), 1 (audit_leaf_pending expected value / subtest ordinal), 5 (fault-injected kernel cap slot for subtest 6 — arbitrary, inside [1..255]), 15/129 (one-below/one-above the length gate's inclusive bounds), 16/128 (AUDIT_LEAF_MIN_BYTES/AUDIT_LEAF_MAX_BYTES loop and length bounds), 32/64 (subtest 7/6 buffer_len values), 0xFFFE (AUDIT_BROKER_SLOT_SATELLITE), 0xFFFF (AUDIT_BROKER_SLOT_UNRESOLVED) — all within the 0x7FFFFFFF cmp-imm bound.",
      block: {
        push r12;
        push r13;

        // ---- Common baseline: reset() clears the .bss state and
        //      primes audit_broker_slot to AUDIT_BROKER_SLOT_UNRESOLVED
        //      (0xFFFF) — the exact precondition subtest 4 depends on.
        call reset;

        // ---- Subtest 1: null buffer_ptr -> AUDIT_LEAF_ERR_NULL_BUFFER.
        xor rdi, rdi;
        mov rsi, 64;
        call audit_append_leaf;
        cmp rax, 0xFFFFFFFFFFFFFFFF;              // AUDIT_LEAF_ERR_NULL_BUFFER (-1)
        jne tal_fail_1;

        // ---- Subtest 2: buffer_len == 15 (undersized) -> BAD_LENGTH. -
        lea rdi, [rip + tal_valid_record];
        mov rsi, 15;
        call audit_append_leaf;
        cmp rax, 0xFFFFFFFFFFFFFFFE;              // AUDIT_LEAF_ERR_BAD_LENGTH (-2)
        jne tal_fail_2;

        // ---- Subtest 3: buffer_len == 129 (oversized) -> BAD_LENGTH. -
        lea rdi, [rip + tal_valid_record];
        mov rsi, 129;
        call audit_append_leaf;
        cmp rax, 0xFFFFFFFFFFFFFFFE;              // AUDIT_LEAF_ERR_BAD_LENGTH (-2)
        jne tal_fail_3;

        // ---- Subtest 4: sink still UNRESOLVED (0xFFFF, from reset()
        //      above) -> AUDIT_LEAF_ERR_SINK_UNAVAILABLE, fail-close.
        lea rdi, [rip + tal_valid_record];
        mov rsi, 64;
        call audit_append_leaf;
        cmp rax, 0xFFFFFFFFFFFFFFFD;              // AUDIT_LEAF_ERR_SINK_UNAVAILABLE (-3)
        jne tal_fail_4;

        // ---- Subtest 5: sink .bss-zero (never touched) -> same -3. ---
        xor rax, rax;
        lea r11, [rip + audit_broker_slot];
        mov [r11], rax;

        lea rdi, [rip + tal_valid_record];
        mov rsi, 64;
        call audit_append_leaf;
        cmp rax, 0xFFFFFFFFFFFFFFFD;              // AUDIT_LEAF_ERR_SINK_UNAVAILABLE (-3)
        jne tal_fail_5;

        // ---- Subtest 6: sink bound to a valid kernel cap slot (5) —
        //      accepted; verify staging postconditions.
        mov rax, 5;
        lea r11, [rip + audit_broker_slot];
        mov [r11], rax;

        lea rdi, [rip + tal_valid_record];
        mov rsi, 64;
        call audit_append_leaf;
        cmp rax, 0;                               // AUDIT_OK
        jne tal_fail_6;

        lea r11, [rip + audit_leaf_pending];
        mov rax, [r11];
        cmp rax, 1;
        jne tal_fail_6;

        lea r11, [rip + audit_leaf_scratch_len];
        mov rax, [r11];
        cmp rax, 64;
        jne tal_fail_6;

        // ---- Byte-compare: audit_leaf_scratch[0..64) must equal
        //      tal_valid_record byte-for-byte (no enrichment). --------
        lea r8, [rip + tal_valid_record];         // r8 = expected cursor
        lea r9, [rip + audit_leaf_scratch];       // r9 = actual cursor
        xor rcx, rcx;                             // byte index = 0

      tal_cmp6_loop:
        cmp rcx, 64;
        jae tal_pad6_loop;

        xor rax, rax;
        mov_b rax, [r8];
        xor rdx, rdx;
        mov_b rdx, [r9];
        cmp rax, rdx;
        jne tal_fail_6;

        add r8, 1;
        add r9, 1;
        add rcx, 1;
        jmp tal_cmp6_loop;

      tal_pad6_loop:
        // ---- Tail check: audit_leaf_scratch[64..128) must be
        //      zero-padded. r9 already sits at audit_leaf_scratch + 64
        //      from the loop above; rcx continues from 64. -------------
        cmp rcx, 128;
        jae tal_6_pass;

        xor rax, rax;
        mov_b rax, [r9];
        cmp rax, 0;
        jne tal_fail_6;

        add r9, 1;
        add rcx, 1;
        jmp tal_pad6_loop;

      tal_6_pass:
        // ---- Subtest 7: sink bound to the AuditBrokerSatellite
        //      sentinel (0xFFFE) with a different valid length (32) —
        //      also accepted.
        mov rax, 0xFFFE;                          // AUDIT_BROKER_SLOT_SATELLITE
        lea r11, [rip + audit_broker_slot];
        mov [r11], rax;

        lea rdi, [rip + tal_valid_record];
        mov rsi, 32;
        call audit_append_leaf;
        cmp rax, 0;                               // AUDIT_OK
        jne tal_fail_7;

        lea r11, [rip + audit_leaf_scratch_len];
        mov rax, [r11];
        cmp rax, 32;
        jne tal_fail_7;

        // All subtests passed.
        xor rax, rax;
        pop r13;
        pop r12;
        ret;

      tal_fail_1:
        mov rax, 1;
        pop r13;
        pop r12;
        ret;

      tal_fail_2:
        mov rax, 2;
        pop r13;
        pop r12;
        ret;

      tal_fail_3:
        mov rax, 3;
        pop r13;
        pop r12;
        ret;

      tal_fail_4:
        mov rax, 4;
        pop r13;
        pop r12;
        ret;

      tal_fail_5:
        mov rax, 5;
        pop r13;
        pop r12;
        ret;

      tal_fail_6:
        mov rax, 6;
        pop r13;
        pop r12;
        ret;

      tal_fail_7:
        mov rax, 7;
        pop r13;
        pop r12;
        ret;
      }
    }
}
