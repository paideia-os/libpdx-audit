// tests/test_replay_golden.pdx — libpdx-audit.M4-002 + ENH-004 + LA.M1-002 (#21) + LA.M1-004 (#23)
// Driver for the "audit-journal replay correctness against a known
// trace" invariant. Verifies the library-observable pieces of the
// wire-format contract that a supervisor replaying the audit journal
// would need to hold byte-for-byte: state-machine transitions, hash
// primitives, spec constants, and parent-child linkage propagation
// into the marshalling scratch.
//
// The byte-for-byte marshalling verification (audit_payload_scratch
// vs. tests/goldens/trace_001.md) requires audit_send_record to run,
// which invokes sys_ipc_send — a live kernel call. Since libpdx-audit
// is a shared library with no runnable executable of its own and the
// kernel-side audit_journal_broker_dispatch is still stubbed
// (AJB_DISPATCH_STUB), that verification lives in the QEMU smoke
// matrix once a consumer tool (pkg/shell) hosts the driver. This
// file covers what can be verified from the library's own type +
// memory surface: the state machine + hash + parent-slot invariants
// that MUST hold before the marshalling step runs.
//
// Return convention (identical to test_broker_refusal.pdx):
//
//   0                       — all subtests passed.
//   1..N (small u64)         — failing subtest ordinal.
//
// Effects `!{mem} @{}` — pure .bss read/write across reset(),
// audit_hash_init/update/finalize, audit_set_parent. No syscall.
//
// See tests/goldens/trace_001.md for the wire-bytes fixture the QEMU
// harness compares audit_payload_scratch against. See design/
// architecture.md §13 for the test discipline this file lives under.
//
// Cross-module functions called:
//   AuditRecord::reset               (src/audit_record.pdx)
//   AuditRecord::audit_rearm         (src/audit_record.pdx, ENH-004)
//   AuditHash::audit_hash_init       (src/audit_hash.pdx, M3-001)
//   AuditHash::audit_hash_update     (src/audit_hash.pdx, M3-001)
//   AuditHash::audit_hash_finalize   (src/audit_hash.pdx, M3-001)
//   AuditClient::audit_set_parent    (src/audit_client.pdx, M3-002)
// Cross-module .bss symbols read/written:
//   record_state                     (src/audit_record.pdx)
//   record_hash_state                (src/audit_record.pdx, M3-001)
//   record_hash_active               (src/audit_record.pdx, M3-001)
//   record_parent_audit_id           (src/audit_record.pdx, M3-002)
//   audit_broker_slot                (src/audit_record.pdx)
//   record_exit_code, record_output_schema_ptr, record_output_hash,
//   audit_id_next, audit_broker_failed  (src/audit_record.pdx, ENH-004
//   subtest 9)

module TestReplayGolden = structure {

  // ============================================================================
  // The M4-002 "no-op update" fixture pointer target. A u64 scratch
  // slot the update-len=0 and update-inactive subtests point at; the
  // gates fire before any byte is loaded, so the slot's content is
  // irrelevant. Declared as u64 (rather than u8) to match every other
  // .bss slot in this repo — the pattern `pub let mut X : u64 = uninit
  // @align(8)` is the only .bss shape libpdx-audit exercises so far,
  // and staying inside it keeps this test file's paideia-as encoding
  // identical to every other module. Kept in .bss (zero-init).
  // ============================================================================
  pub let mut trg_null_scratch : u64 = uninit @align(8)

  // ============================================================================
  // LA.M1-004 (#23) FNV-1a-64 known-vector fixtures. Byte arrays fed
  // through AuditHash::audit_hash_update; the accumulator is compared
  // against independently-computable reference values.
  //
  // Reference vectors are the FNV author's canonical fnvtest.c set,
  // reproducible from the FNV-1a-64 specification:
  //   offset_basis = 0xcbf29ce484222325
  //   prime        = 0x100000001b3
  //   for each byte b: h = (h ^ b) * prime   (mod 2^64)
  //
  // "foobar" (6 bytes, ASCII) hashes to 0x85944171f73967e8 — the
  // reference vector cited in the FNV author's test suite at
  // http://www.isthe.com/chongo/tech/comp/fnv/ (row 10 of the
  // fnv1a-64 vector table). Second vector: subtest 11 verifies the
  // FNV-1a-64 incremental property by folding the same bytes in
  // chunks ("foo" then "bar") and expecting the same accumulator
  // value — a stronger check than a second hand-computed hash
  // because a wrong loop bound in audit_hash_update would still
  // agree with itself against a hand-computed value while breaking
  // the incremental property. Together they cover both single-call
  // correctness and multi-call state-persistence correctness
  // (each update advances record_hash_state; audit_hash_finalize
  // reads the accumulated state one final time). The strings live
  // in the read-only `pub let` form so audit_hash_update can walk
  // them via `xor rax,rax; mov_b rax,[rsi]` per the paideia-as
  // #1248 byte-load discipline.
  // ============================================================================
  pub let trg_fnv_foobar : [u8; 6] = "foobar"
  pub let trg_fnv_foo    : [u8; 3] = "foo"
  pub let trg_fnv_bar    : [u8; 3] = "bar"

  // ============================================================================
  // test_replay_golden_run() -> u64
  //
  // Executes the M4-002 + ENH-004 + LA.M1-004 subtest sequence in order.
  // Returns 0 on all-pass or the ordinal of the first failing subtest
  // (1..11). LA.M1-002 (#21) renamed the entry point from the bare `run`
  // to the namespaced `test_replay_golden_run` — external test runners
  // that referenced `TestReplayGolden::run()` (or the unqualified linker
  // symbol `run`) must migrate to
  // `TestReplayGolden::test_replay_golden_run()`.
  //
  // Subtest ledger:
  //
  //   1  reset()          -> record_state = IDLE (0)
  //   2  audit_hash_init()  then audit_hash_finalize() with NO update
  //      calls between them returns FNV_OFFSET_BASIS (0xcbf29ce484222325)
  //      — the FNV-1a-64 empty-stream self-check. This is the canonical
  //      known-vector for the M3-001 primitive and does not require
  //      byte-level FNV arithmetic to verify. (See RFC-1321-style FNV
  //      spec: h_final(empty) = FNV_OFFSET_BASIS.)
  //   3  after finalize, record_hash_active is cleared to 0
  //   4  audit_hash_update called BEFORE any init returns
  //      AUDIT_ERR_HASH_INACTIVE (5) — defence-in-depth gate.
  //   5  audit_hash_init then audit_hash_update(ptr, 0) returns
  //      AUDIT_OK (0) — len=0 is a legal no-op.
  //   6  after the len=0 update, record_hash_state remains
  //      FNV_OFFSET_BASIS — the no-op did not touch the accumulator.
  //   7  audit_set_parent(0x1234567) with record_state = IDLE
  //      returns AUDIT_OK (0) and record_parent_audit_id becomes
  //      0x1234567 — the M3-002 parent-linkage propagation into
  //      the .bss slot that audit_send_record marshals at index [7].
  //   8  audit_set_parent called with record_state != IDLE (fault-
  //      inject record_state = 1 = BEGUN) returns AUDIT_ERR_STATE
  //      (1) — parent linkage cannot be mutated mid-flight per
  //      design/architecture.md §12.1.
  //   9  (ENH-004) audit_rearm() clears record_exit_code /
  //      record_output_schema_ptr / record_output_hash while
  //      preserving audit_id_next / audit_broker_slot /
  //      audit_broker_failed. Fault-inject all six slots to non-
  //      baseline values, call audit_rearm(), then verify the three
  //      content slots read back 0 and the three preserved slots
  //      still hold their fault-injected values.
  //  10  (LA.M1-004 / #23) FNV-1a-64 known vector: hash "foobar"
  //      (6 bytes) in one update() call and assert the accumulator
  //      equals 0x85944171f73967e8 — the FNV author's canonical
  //      reference vector (fnvtest.c row 10; reproducible from the
  //      spec: offset_basis 0xcbf29ce484222325, prime 0x100000001b3,
  //      for each byte b: h = (h ^ b) * prime, mod 2^64).
  //  11  (LA.M1-004 / #23) FNV-1a-64 incremental property: hash
  //      "foo" then "bar" in two separate update() calls and assert
  //      the accumulator equals the same 0x85944171f73967e8 —
  //      proves audit_hash_update correctly persists
  //      record_hash_state across calls, catches a hypothetical
  //      accumulator-reload bug that a single-call vector would
  //      miss.
  //
  // Register plan (leaf; two calls that take args need arg preservation
  // across ONE call each — no state shared between call sites):
  //   rax = call returns / .bss loads
  //   r11 = LEA scratch
  //   r12 = ordinal marker across subtests (SysV callee-save, pushed).
  //   r13 = FNV_OFFSET_BASIS staged for the two u64 compares that need
  //         it (SysV callee-save, pushed for alignment parity).
  //
  // Every immediate fits inside the paideia-as 0x7FFFFFFF cmp-imm bound.
  // FNV_OFFSET_BASIS (0xcbf29ce484222325) exceeds it but is loaded via
  // MOVABS into r13 then compared reg-to-reg — a valid encoding path.
  // ============================================================================

  pub let test_replay_golden_run : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-audit.M4-002 + ENH-004 + LA.M1-002 (#21) + LA.M1-004 (#23): TestReplayGolden::test_replay_golden_run entry point (renamed from the pre-LA.M1-002 bare `run` per #21 for the same test-runner symbol-collision reason test_broker_refusal_run was renamed). Sequential subtest driver: eleven .bss-and-API-only checks covering the state-machine reset invariant, the FNV-1a-64 empty-stream self-check (M3-001 known-vector: h_final(empty) = FNV_OFFSET_BASIS 0xcbf29ce484222325 — matches the RFC-style FNV spec exactly and requires no byte arithmetic to verify), the hash active-flag gates (subtests 3+4), the len=0 no-op path (subtests 5+6), the parent-linkage state-gate contract (subtests 7+8), the ENH-004 audit_rearm selective-clear invariant (subtest 9), and (LA.M1-004 / #23) two new FNV-1a-64 correctness subtests — subtest 10 hashes 'foobar' (6 bytes) in one update() call and asserts the accumulator equals the FNV author's canonical reference vector 0x85944171f73967e8 (independently reproducible from the spec: for each byte b, h = (h ^ b) * FNV_PRIME, mod 2^64), subtest 11 hashes 'foo' then 'bar' in two separate update() calls and asserts the same result, verifying the incremental property (a wrong per-iteration state persist/reload in audit_hash_update would still agree with itself against a hand-computed single-shot hash but would break this equality). Together the two vectors cover single-call correctness AND multi-call state-persistence correctness that neither vector alone catches. Subtest 4 relies on the M3-001 defence-in-depth invariant: calling audit_hash_update without a prior audit_hash_init returns AUDIT_ERR_HASH_INACTIVE=5 rather than silently folding bytes into the .bss zero baseline. Subtest 7 exercises the M3-002 audit_set_parent → record_parent_audit_id propagation directly; the .bss slot is what AuditBroker::audit_send_record marshals into payload offset 24 on every INVOKE/OUTPUT/EXIT, so verifying it holds the caller-passed value proves the wire-format handoff. Subtest 8 verifies the IDLE gate on audit_set_parent (record_state != IDLE → AUDIT_ERR_STATE) — parent linkage is a property of the audit's identity per design/architecture.md §12.1. Subtest 9 fault-injects all six slots audit_rearm touches or must NOT touch (record_exit_code=0xAA, record_output_schema_ptr=0xBB, record_output_hash=0xCC, audit_id_next=5, audit_broker_slot=7, audit_broker_failed=1), calls audit_rearm, then verifies the three content slots read back 0 while the three process-scoped slots are unchanged — proving the ENH-004 fix (a second audit_begin no longer inherits a prior audit's stale exit_code/schema/hash) without regressing monotonic id allocation, the broker bind cache, or the ENH-008-owned sticky-failure flag. FNV_OFFSET_BASIS staged in r13 via MOVABS since 0xcbf29ce484222325 > 0x7FFFFFFF cmp-imm bound; reg-to-reg compare via `cmp rax, r13`. LA.M1-004 subtests 10+11 stage the reference vector 0x85944171f73967e8 in r13 via MOVABS for the same reason (0x8594... exceeds the 32-bit sign-extended imm range for cmp reg, imm). Fault-injection for subtest 8 writes 1 (AUDIT_STATE_BEGUN) into record_state via `lea r11,[rip+record_state]; mov [r11],rax` (parser.pdx cross-module-write pattern) — bypassing audit_begin lets the driver test audit_set_parent's gate without invoking the sys_ipc_send that audit_begin would trigger. Every callee here is a pure leaf (reset, audit_hash_init/update/finalize, audit_set_parent, audit_rearm all declared !{mem} @{}) so no register state needs preservation beyond r12/r13 (pushed as a pair for SysV callee-save + rsp % 16 alignment). Label prefix trg_ per project reserved-label discipline. Return code: 0 on all-pass, 1..11 = ordinal of first failing subtest. No test mnemonic; every zero-check is cmp reg, 0. Immediates: 0 (state IDLE / AUDIT_OK / .bss zero), 1 (state BEGUN / AUDIT_ERR_STATE fault-inject value / audit_broker_failed fault value), 2..11 (subtest ordinals), 3 (byte count for `foo`/`bar` fixtures at subtest 11), 5 (AUDIT_ERR_HASH_INACTIVE / audit_id_next fault value), 6 (byte count for `foobar` fixture at subtest 10), 7 (audit_broker_slot fault value), 0x1234567 (parent-id sentinel — 25-bit value, well within 0x7FFFFFFF cmp-imm bound and encodable as MOVABS or 32-bit imm for the .bss write), 0xAA/0xBB/0xCC (subtest 9 fault-inject values, all 8-bit-safe 32-bit immediates). FNV_OFFSET_BASIS (0xcbf29ce484222325) and the LA.M1-004 reference vector 0x85944171f73967e8 are both 64-bit — loaded via MOVABS into r13 and used only in reg-to-reg cmp. All within paideia-as encoding gates.",
      block: {
        push r12;
        push r13;

        // Stage FNV_OFFSET_BASIS in r13 once; used at subtests 2 and 6.
        // MOVABS encoding — the constant exceeds the cmp-imm bound.
        mov r13, 0xcbf29ce484222325;             // FNV_OFFSET_BASIS

        // ---- Subtest 1: reset() → record_state = IDLE (0). -----------
        call reset;
        lea r11, [rip + record_state];
        mov rax, [r11];
        cmp rax, 0;                              // AUDIT_STATE_IDLE
        jne trg_fail_1;

        // ---- Subtest 2: hash empty-stream self-check. ----------------
        //      init() + finalize() with no update() calls between must
        //      return FNV_OFFSET_BASIS (the M3-001 known vector).
        call audit_hash_init;
        call audit_hash_finalize;
        cmp rax, r13;                            // rax == FNV_OFFSET_BASIS ?
        jne trg_fail_2;

        // ---- Subtest 3: finalize clears record_hash_active. ----------
        lea r11, [rip + record_hash_active];
        mov rax, [r11];
        cmp rax, 0;
        jne trg_fail_3;

        // ---- Subtest 4: update-before-init returns HASH_INACTIVE. ----
        //      reset() cleared record_hash_active; finalize left it 0.
        //      Any update now must refuse. Args: rdi = &trg_null_scratch
        //      (real .bss address; content irrelevant — the gate fires
        //      before the byte load), rsi = 8 (non-zero len so we don't
        //      hit the len=0 no-op path first).
        lea rdi, [rip + trg_null_scratch];
        mov rsi, 8;
        call audit_hash_update;
        cmp rax, 5;                              // AUDIT_ERR_HASH_INACTIVE
        jne trg_fail_4;

        // ---- Subtest 5: init + update(ptr, 0) returns AUDIT_OK. ------
        call audit_hash_init;
        lea rdi, [rip + trg_null_scratch];
        mov rsi, 0;                              // len=0 no-op
        call audit_hash_update;
        cmp rax, 0;                              // AUDIT_OK
        jne trg_fail_5;

        // ---- Subtest 6: len=0 no-op leaves state = FNV_OFFSET_BASIS. -
        lea r11, [rip + record_hash_state];
        mov rax, [r11];
        cmp rax, r13;                            // still FNV_OFFSET_BASIS ?
        jne trg_fail_6;

        // ---- Reset before the parent-linkage subtests so record_state
        //      is guaranteed IDLE.
        call reset;

        // ---- Subtest 7: audit_set_parent(0x1234567) with IDLE state
        //      returns AUDIT_OK and writes the value to the .bss slot.
        mov rdi, 0x1234567;                      // canonical parent id
        call audit_set_parent;
        cmp rax, 0;                              // AUDIT_OK
        jne trg_fail_7;

        lea r11, [rip + record_parent_audit_id];
        mov rax, [r11];
        cmp rax, 0x1234567;
        jne trg_fail_7;

        // ---- Subtest 8: audit_set_parent with state != IDLE refuses. -
        //      Fault-inject record_state = 1 (AUDIT_STATE_BEGUN) via
        //      direct .bss write, bypassing audit_begin (which would
        //      call sys_ipc_send). audit_set_parent must return
        //      AUDIT_ERR_STATE (1) per design/architecture.md §12.1.
        mov rax, 1;                              // AUDIT_STATE_BEGUN
        lea r11, [rip + record_state];
        mov [r11], rax;

        mov rdi, 0x89ABCDE;                      // a different parent id
        call audit_set_parent;
        cmp rax, 1;                              // AUDIT_ERR_STATE
        jne trg_fail_8;

        // Restore state to IDLE so a subsequent driver run starts clean.
        call reset;

        // ---- Subtest 9 (ENH-004): audit_rearm() clears the per-audit
        //      content slots while preserving the process-scoped ones.
        //      Fault-inject all six slots to non-baseline values first.
        mov rax, 0xAA;                            // record_exit_code
        lea r11, [rip + record_exit_code];
        mov [r11], rax;

        mov rax, 0xBB;                            // record_output_schema_ptr
        lea r11, [rip + record_output_schema_ptr];
        mov [r11], rax;

        mov rax, 0xCC;                            // record_output_hash
        lea r11, [rip + record_output_hash];
        mov [r11], rax;

        mov rax, 5;                               // audit_id_next (preserved)
        lea r11, [rip + audit_id_next];
        mov [r11], rax;

        mov rax, 7;                               // audit_broker_slot (preserved)
        lea r11, [rip + audit_broker_slot];
        mov [r11], rax;

        mov rax, 1;                               // audit_broker_failed (preserved)
        lea r11, [rip + audit_broker_failed];
        mov [r11], rax;

        call audit_rearm;

        lea r11, [rip + record_exit_code];
        mov rax, [r11];
        cmp rax, 0;
        jne trg_fail_9;

        lea r11, [rip + record_output_schema_ptr];
        mov rax, [r11];
        cmp rax, 0;
        jne trg_fail_9;

        lea r11, [rip + record_output_hash];
        mov rax, [r11];
        cmp rax, 0;
        jne trg_fail_9;

        lea r11, [rip + audit_id_next];
        mov rax, [r11];
        cmp rax, 5;                               // unchanged
        jne trg_fail_9;

        lea r11, [rip + audit_broker_slot];
        mov rax, [r11];
        cmp rax, 7;                               // unchanged
        jne trg_fail_9;

        lea r11, [rip + audit_broker_failed];
        mov rax, [r11];
        cmp rax, 1;                               // unchanged
        jne trg_fail_9;

        // Restore clean state for a subsequent driver run.
        call reset;

        // ---- Subtest 10 (LA.M1-004 / #23): FNV-1a-64 known vector for
        //      "foobar" (6 bytes) — expect 0x85944171f73967e8. Reference
        //      vector from the FNV author's canonical fnvtest.c set
        //      (row 10 of the fnv1a-64 vector table at
        //      http://www.isthe.com/chongo/tech/comp/fnv/). Independently
        //      reproducible by hand-application of the spec:
        //        h = FNV_OFFSET_BASIS (0xcbf29ce484222325)
        //        for each byte b in "foobar":
        //            h = (h ^ b) * FNV_PRIME (0x100000001b3)   mod 2^64
        //      Reload r13 with the reference vector (r13 previously held
        //      FNV_OFFSET_BASIS for subtests 2+6; MOVABS reload is
        //      required since 0x8594... exceeds the 32-bit cmp-imm
        //      bound). Compare rax to r13 via reg-to-reg cmp.
        call audit_hash_init;
        lea rdi, [rip + trg_fnv_foobar];
        mov rsi, 6;                               // byte count
        call audit_hash_update;
        cmp rax, 0;                               // AUDIT_OK ?
        jne trg_fail_10;

        call audit_hash_finalize;
        mov r13, 0x85944171f73967e8;              // FNV-1a-64("foobar")
        cmp rax, r13;
        jne trg_fail_10;

        // ---- Subtest 11 (LA.M1-004 / #23): FNV-1a-64 incremental
        //      property — hashing "foo" then "bar" in two separate
        //      update() calls MUST produce the same accumulator value
        //      as hashing "foobar" in one call, because FNV-1a's per-
        //      byte fold has no cross-byte carry and audit_hash_update
        //      re-loads / stores record_hash_state around each call.
        //      A wrong per-iteration state persist/reload would still
        //      agree with a hand-computed single-shot vector (subtest
        //      10) but would break this equality — the two subtests
        //      together are a stronger check than either alone.
        call audit_hash_init;

        lea rdi, [rip + trg_fnv_foo];
        mov rsi, 3;                               // byte count for "foo"
        call audit_hash_update;
        cmp rax, 0;
        jne trg_fail_11;

        lea rdi, [rip + trg_fnv_bar];
        mov rsi, 3;                               // byte count for "bar"
        call audit_hash_update;
        cmp rax, 0;
        jne trg_fail_11;

        call audit_hash_finalize;
        mov r13, 0x85944171f73967e8;              // FNV-1a-64("foobar")
        cmp rax, r13;
        jne trg_fail_11;

        // All subtests passed.
        xor rax, rax;                            // 0 = all pass
        pop r13;
        pop r12;
        ret;

      trg_fail_1:
        mov rax, 1;
        pop r13;
        pop r12;
        ret;

      trg_fail_2:
        mov rax, 2;
        pop r13;
        pop r12;
        ret;

      trg_fail_3:
        mov rax, 3;
        pop r13;
        pop r12;
        ret;

      trg_fail_4:
        mov rax, 4;
        pop r13;
        pop r12;
        ret;

      trg_fail_5:
        mov rax, 5;
        pop r13;
        pop r12;
        ret;

      trg_fail_6:
        mov rax, 6;
        pop r13;
        pop r12;
        ret;

      trg_fail_7:
        mov rax, 7;
        pop r13;
        pop r12;
        ret;

      trg_fail_8:
        mov rax, 8;
        pop r13;
        pop r12;
        ret;

      trg_fail_9:
        mov rax, 9;
        pop r13;
        pop r12;
        ret;

      trg_fail_10:
        mov rax, 10;
        pop r13;
        pop r12;
        ret;

      trg_fail_11:
        mov rax, 11;
        pop r13;
        pop r12;
        ret;
      }
    }
}
