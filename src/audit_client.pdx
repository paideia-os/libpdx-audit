// src/audit_client.pdx — libpdx-audit.M1-001 + M1-002 + M2-001 + M2-002 + M3-002
// AuditClient: three-call user-facing API — audit_begin, audit_record_
// output, audit_commit. State-machine gating per design/architecture.md
// §4; wire format per §2. M1-002 stitched the send path in at commit;
// M2-001 promotes every lifecycle transition into its own IPC send so
// a supervisor sees three discriminable events per audit (INVOKE at
// begin, OUTPUT at record_output, EXIT at commit) via
// AuditBroker::audit_send_record(event_kind).
//
// Effects widened across all three entry points: M1's audit_begin and
// audit_record_output were `!{mem} @{}` because only audit_commit
// touched the broker; M2-001 makes every entry point issue an IPC send
// so all three now declare `!{mem, sysreg} @{cap, sched}` matching
// audit_send_record's effect tail.
//
// See design/architecture.md §1 for the caller wire-up example and §5
// for the audit_id allocation shape audit_begin implements.
// Upstream: design/tooling/r49-r50-plan.md §3.4 + §5.13 (paideia-os).
//
// Cross-module symbols read/written (all in AuditRecord .bss):
//   audit_id_next, record_audit_id, record_op_name_ptr,
//   record_op_args_ptr, record_output_schema_ptr, record_output_hash,
//   record_exit_code, record_state, audit_broker_failed (M2-002 read
//   in audit_can_emit_output), record_parent_audit_id (M3-002 write
//   in audit_set_parent)
// Cross-module functions called (M2-001):
//   audit_send_record  (src/audit_broker.pdx)
// Resolved by unqualified linker name — the same pattern
// libpdx-argv's parser.pdx uses to read ParsedArgs::flag_count.

module AuditClient = structure {

  // ============================================================================
  // audit_begin(op_name, op_args) -> u64
  //   rdi = op_name        (NUL-terminated string ptr; MUST be non-zero)
  //   rsi = op_args        (NUL-terminated string ptr; may be zero if
  //                          the tool has no argv beyond op_name)
  //   rax = audit_id (>0) on success; 0 on AUDIT_ERR_STATE (record
  //                        already in a non-IDLE state)
  //
  // Requires record_state == AUDIT_STATE_IDLE. On success transitions
  // record_state to AUDIT_STATE_BEGUN and returns the newly-allocated
  // audit_id. Lazy-inits audit_id_next to 1 on the very first call so
  // audit_id 0 remains the "no audit in progress" sentinel.
  //
  // Register plan (leaf; no callee-save touched):
  //   r11 = LEA scratch (paideia-as reserved scratch; every cross-module
  //         write is r11-based)
  //   rax = state-load / id-allocation / return value
  //   rcx = new state / new counter (avoids reusing rax across the two
  //         adjacent stores)
  // ============================================================================

  pub let audit_begin : (u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (op_name: u64) (op_args: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "libpdx-audit.M1-001 + M1-002 + M2-001: audit_begin entry point. Validates record_state == AUDIT_STATE_IDLE (0) via cmp reg, 0 (no test mnemonic per paideia-as conformance); on gate failure returns 0 to signal AUDIT_ERR_STATE. Lazy-init: if audit_id_next == 0 (the .bss zero start; reset() writes 1 but a consumer that skipped reset would still get a valid first id from this branch), write 1 into audit_id_next. Allocate id = audit_id_next, post-increment audit_id_next; store id in record_audit_id; store op_name / op_args in the record; write AUDIT_STATE_BEGUN (1) to record_state. M2-001 upgrade: after the state transition, call AuditBroker::audit_send_record(UEJ_KIND_TOOL_INVOKE=130) so the supervisor sees the tool starting. On send success reload record_audit_id into rax (payload marshal reads .bss so id was not clobbered but rax is now the send-return code — reload for cleanliness) and return it. On send failure return 0 — same sentinel as the state-gate failure since both mean 'consumer must exit 3 per I4'. record_state stays at BEGUN on send failure so post-mortem can walk the record; caller ignoring the 0 return and calling audit_record_output(0, ...) would fail the id gate with AUDIT_ERR_ID_MISMATCH. Effects widened from M1's !{mem} @{} to !{mem, sysreg} @{cap, sched} to match audit_send_record's tail (mem via user_bounce_send, sysreg via sched_wake, @{cap} for endpoint-cap consume, @{sched} for wake path). Every cross-module write uses `lea r11,[rip+sym]; mov [r11],reg` per the libpdx-argv parser.pdx pattern. Leaf function w.r.t. callee-saves — rdi/rsi captured into .bss before the send call so no push/pop needed for arg preservation; audit_send_record preserves rbx/r12..r15 by SysV. Register plan: rax = id/return/send-return, rcx = counter+state scratch, r11 = LEA scratch, rdi = op_name (arg + audit_send_record's event_kind), rsi = op_args (arg). Immediates: 0 (state gate + AUDIT_OK compare), 1 (lazy-init + state transition), 130 (UEJ_KIND_TOOL_INVOKE) — all within the 0x7FFFFFFF cmp-imm constraint.",
      block: {
        // ---- Gate 1: record_state must be IDLE (0) --------------------
        lea r11, [rip + record_state];
        mov rax, [r11];
        cmp rax, 0;                              // AUDIT_STATE_IDLE
        jne audit_begin_bad_state;

        // ---- Lazy-init audit_id_next to 1 if the caller skipped
        //      AuditRecord::reset() (defence-in-depth; reset() writes 1). -
        lea r11, [rip + audit_id_next];
        mov rax, [r11];
        cmp rax, 0;
        jne audit_begin_have_counter;
        mov rax, 1;
        lea r11, [rip + audit_id_next];
        mov [r11], rax;

      audit_begin_have_counter:
        // ---- Allocate id: id = audit_id_next; audit_id_next += 1 -----
        lea r11, [rip + audit_id_next];
        mov rax, [r11];                          // rax = id to hand out
        mov rcx, rax;
        add rcx, 1;
        lea r11, [rip + audit_id_next];
        mov [r11], rcx;                          // audit_id_next += 1

        // ---- Store id into the in-progress record --------------------
        lea r11, [rip + record_audit_id];
        mov [r11], rax;                          // record_audit_id = id

        // ---- Store op_name / op_args pointers ------------------------
        lea r11, [rip + record_op_name_ptr];
        mov [r11], rdi;
        lea r11, [rip + record_op_args_ptr];
        mov [r11], rsi;

        // ---- Transition record_state IDLE -> BEGUN -------------------
        mov rcx, 1;                              // AUDIT_STATE_BEGUN
        lea r11, [rip + record_state];
        mov [r11], rcx;

        // ---- M2-001: emit UEJ_KIND_TOOL_INVOKE. -----------------------
        mov rdi, 130;                            // UEJ_KIND_TOOL_INVOKE
        call audit_send_record;
        cmp rax, 0;                              // AUDIT_OK ?
        jne audit_begin_send_fail;

        // Send succeeded — return the allocated audit_id.
        lea r11, [rip + record_audit_id];
        mov rax, [r11];
        ret;

      audit_begin_send_fail:
        // Broker/send failure — treat as fatal for the caller. Return 0
        // (same sentinel as state failure); consumer's I4 contract is
        // to exit 3 with no output emission. record_state stays at
        // BEGUN so a post-mortem can walk the in-progress record.
        xor rax, rax;
        ret;

      audit_begin_bad_state:
        xor rax, rax;                            // 0 = AUDIT_ERR_STATE for begin
        ret;
      }
    }

  // ============================================================================
  // audit_record_output(audit_id, output_schema, output_hash) -> u64
  //   rdi = audit_id
  //   rsi = output_schema   (NUL-terminated schema-name ptr; may be 0
  //                          for a schema-less passthrough record)
  //   rdx = output_hash     (M1: caller-supplied u64; M3-001 computes
  //                          from the tool's actual output stream)
  //   rax = AUDIT_OK on success; AUDIT_ERR_STATE or AUDIT_ERR_ID_MISMATCH
  //         on gate failure.
  //
  // Requires record_state == AUDIT_STATE_BEGUN and audit_id ==
  // record_audit_id. Transitions record_state to AUDIT_STATE_OUTPUT.
  //
  // Optional per §4 of design/architecture.md: a read-only tool that
  // emits no schema-typed output may skip this and go straight to
  // audit_commit.
  // ============================================================================

  pub let audit_record_output : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (audit_id: u64) (output_schema: u64) (output_hash: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "libpdx-audit.M1-001 + M2-001: audit_record_output entry point. Two gates evaluated in order (state before id, per §4 of design/architecture.md — a stale id passed after commit surfaces as AUDIT_ERR_STATE, not AUDIT_ERR_ID_MISMATCH): (1) record_state == AUDIT_STATE_BEGUN (1); (2) rdi == record_audit_id. On both passing, store output_schema into record_output_schema_ptr, output_hash into record_output_hash, transition record_state BEGUN -> OUTPUT (2). M2-001 upgrade: after the state transition, call AuditBroker::audit_send_record(UEJ_KIND_TOOL_OUTPUT=132) so the supervisor sees the output-record event. Return audit_send_record's code verbatim — AUDIT_OK on send success, AUDIT_ERR_BROKER_UNAVAILABLE (3) or AUDIT_ERR_SEND_FAILED (4) on failure. Consumer's I4 contract on any non-OK: exit 3 with no output emission. Cross-module writes via lea r11,[rip+sym]+mov per parser.pdx pattern. Effects widened from M1's !{mem} @{} to !{mem, sysreg} @{cap, sched} matching audit_send_record. Leaf w.r.t. callee-saves — output_schema/output_hash captured into .bss before the send call so no arg preservation needed; audit_send_record preserves rbx/r12..r15 by SysV. Register plan: rax = state-load / return code, rcx unused, r11 = LEA scratch, rdi = audit_id (validated) then event_kind arg to audit_send_record. Immediates: 1 (BEGUN gate + AUDIT_ERR_STATE), 2 (state transition + AUDIT_ERR_ID_MISMATCH), 132 (UEJ_KIND_TOOL_OUTPUT) — all within paideia-as cmp-imm bounds.",
      block: {
        // ---- Gate 1: record_state must be BEGUN (1) ------------------
        lea r11, [rip + record_state];
        mov rax, [r11];
        cmp rax, 1;                              // AUDIT_STATE_BEGUN
        jne audit_ro_bad_state;

        // ---- Gate 2: audit_id must match ------------------------------
        lea r11, [rip + record_audit_id];
        mov rax, [r11];
        cmp rax, rdi;
        jne audit_ro_bad_id;

        // ---- Store output_schema + output_hash -----------------------
        lea r11, [rip + record_output_schema_ptr];
        mov [r11], rsi;
        lea r11, [rip + record_output_hash];
        mov [r11], rdx;

        // ---- Transition BEGUN -> OUTPUT ------------------------------
        mov rax, 2;                              // AUDIT_STATE_OUTPUT
        lea r11, [rip + record_state];
        mov [r11], rax;

        // ---- M2-001: emit UEJ_KIND_TOOL_OUTPUT. -----------------------
        mov rdi, 132;                            // UEJ_KIND_TOOL_OUTPUT
        call audit_send_record;
        // rax already carries AUDIT_OK / AUDIT_ERR_BROKER_UNAVAILABLE /
        // AUDIT_ERR_SEND_FAILED — propagate verbatim.
        ret;

      audit_ro_bad_state:
        mov rax, 1;                              // AUDIT_ERR_STATE
        ret;

      audit_ro_bad_id:
        mov rax, 2;                              // AUDIT_ERR_ID_MISMATCH
        ret;
      }
    }

  // ============================================================================
  // audit_commit(audit_id, exit_code) -> u64
  //   rdi = audit_id
  //   rsi = exit_code
  //   rax = AUDIT_OK on success;
  //       | AUDIT_ERR_STATE / AUDIT_ERR_ID_MISMATCH  on gate failure
  //       | AUDIT_ERR_BROKER_UNAVAILABLE             if bind fails
  //       | AUDIT_ERR_SEND_FAILED                    if sys_ipc_send fails
  //
  // M1-002 body: validates state (BEGUN or OUTPUT) and id, stores
  // exit_code, transitions record_state to COMMITTED, then delegates
  // to AuditBroker::audit_send_committed_record (src/audit_broker.pdx)
  // to bind the broker (idempotent) and issue sys_ipc_send. On send
  // success, resets record_state to IDLE so a subsequent audit_begin
  // in the same process can start a fresh record; on send failure,
  // leaves record_state at COMMITTED so a diagnostic can walk the
  // record post-mortem.
  //
  // Consumer contract on any non-OK return: exit 3 per I4 (system
  // error) and MUST NOT emit user-visible output. This is the D3
  // audit-first upgrade — a tool that cannot prove its output was
  // journalled is a tool whose output the operator cannot trust.
  // ============================================================================

  pub let audit_commit : (u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (audit_id: u64) (exit_code: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "libpdx-audit.M1-001 + M1-002 + M2-001: audit_commit entry point. State gate accepts BEGUN (1) OR OUTPUT (2) — a tool that skipped audit_record_output still commits legally. Id gate identical to audit_record_output's; state-before-id ordering per §4 of design/architecture.md. On both passing, store exit_code, transition record_state -> COMMITTED (3), then call AuditBroker::audit_send_record(UEJ_KIND_TOOL_EXIT=133) (M2-001 supersedes the M1-002 audit_send_committed_record which hard-coded INVOKE). audit_send_record's return code propagates verbatim: AUDIT_OK, AUDIT_ERR_BROKER_UNAVAILABLE (3), or AUDIT_ERR_SEND_FAILED (4). On AUDIT_OK, reset record_state to IDLE (0) so a subsequent audit_begin can start fresh; on failure, leave record_state at COMMITTED so a diagnostic can walk the record post-mortem. Effects declared !{mem, sysreg} @{cap, sched} — same as M1-002 (audit_send_record's tail is identical to the M1 audit_send_committed_record). Register plan: rdi = audit_id (validated) then event_kind arg to audit_send_record, rsi = exit_code (stored then discarded), rax = return, rcx = zero-write value for the IDLE reset (avoids clobbering rax which carries AUDIT_OK), r11 = LEA scratch. audit_send_record preserves rbx/r12..r15 by SysV so this function saves no callee-save. Immediates: 1 (BEGUN gate), 2 (OUTPUT gate), 3 (COMMITTED transition), 0 (IDLE reset + AUDIT_OK compare), 133 (UEJ_KIND_TOOL_EXIT) — all within paideia-as cmp-imm bounds.",
      block: {
        // ---- Gate 1: record_state must be BEGUN (1) OR OUTPUT (2) ----
        lea r11, [rip + record_state];
        mov rax, [r11];
        cmp rax, 1;                              // AUDIT_STATE_BEGUN
        je  audit_commit_state_ok;
        cmp rax, 2;                              // AUDIT_STATE_OUTPUT
        je  audit_commit_state_ok;
        mov rax, 1;                              // AUDIT_ERR_STATE
        ret;

      audit_commit_state_ok:
        // ---- Gate 2: audit_id must match ------------------------------
        lea r11, [rip + record_audit_id];
        mov rax, [r11];
        cmp rax, rdi;
        je  audit_commit_id_ok;
        mov rax, 2;                              // AUDIT_ERR_ID_MISMATCH
        ret;

      audit_commit_id_ok:
        // ---- Store exit_code + transition to COMMITTED (3) ------------
        lea r11, [rip + record_exit_code];
        mov [r11], rsi;
        mov rax, 3;                              // AUDIT_STATE_COMMITTED
        lea r11, [rip + record_state];
        mov [r11], rax;

        // ---- M2-001: emit UEJ_KIND_TOOL_EXIT via audit_send_record. --
        mov rdi, 133;                            // UEJ_KIND_TOOL_EXIT
        call audit_send_record;

        // ---- On AUDIT_OK, reset record_state to IDLE so a subsequent
        //      audit_begin can start fresh. rax already = 0; use rcx
        //      for the state write so the return code survives.
        cmp rax, 0;                              // AUDIT_OK
        jne audit_commit_done;

        xor rcx, rcx;                            // AUDIT_STATE_IDLE
        lea r11, [rip + record_state];
        mov [r11], rcx;

      audit_commit_done:
        ret;
      }
    }

  // ============================================================================
  // audit_can_emit_output() -> u64
  //   rax = 1 iff it is safe for the consumer to write to stdout/stderr
  //       | 0 iff the consumer MUST exit 3 (per I4) without emitting
  //             any user-visible output.
  //
  // M2-002 guard. Consumers wrap every user-visible write with a
  // pre-check on this — the D3 audit-first invariant says a tool whose
  // audit trail was not journalled cannot be trusted, so its output
  // must be suppressed. Cheap: one .bss load + one compare.
  //
  // Returns 0 if the sticky AuditRecord::audit_broker_failed flag has
  // been set by any prior audit_send_record failure (either broker-
  // unreachable at bind time or sys_ipc_send returning non-zero); this
  // is the "refuse output" signal. Returns 1 otherwise. .bss zeroing
  // means the flag reads 0 (safe) before any send has been attempted;
  // a caller who invokes audit_can_emit_output before audit_begin gets
  // the correct "no prior failure" answer.
  //
  // Consumers typically wire this as:
  //
  //     let id = AuditClient::audit_begin(op_name, op_args)
  //     if id == 0 { sys_exit(3) }                    // begin failed
  //     … tool does its work …
  //     if AuditClient::audit_can_emit_output() == 0 {
  //         sys_exit(3)                                // refuse output
  //     }
  //     … tool emits output …
  //
  // No callee-save touched — pure leaf.
  // ============================================================================

  pub let audit_can_emit_output : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-audit.M2-002: audit_can_emit_output guard. One .bss load of AuditRecord::audit_broker_failed via `lea r11,[rip+audit_broker_failed]; mov rax,[r11]`; then `cmp rax, 0` (no test mnemonic per paideia-as conformance). On flag == 0 return 1 (safe to emit output); on flag != 0 return 0 (refuse output, exit 3 per I4). Pure leaf — no callee-save touched, no push/pop. Register plan: rax = flag-load / return, r11 = LEA scratch. Effects `!{mem} @{}` — only a .bss read, no syscall, no cap consumption. Immediates: 0 (flag compare) + 1 (safe return value) — both within paideia-as cmp-imm bounds.",
      block: {
        lea r11, [rip + audit_broker_failed];
        mov rax, [r11];
        cmp rax, 0;
        jne audit_cee_no;

        mov rax, 1;                              // safe to emit output
        ret;

      audit_cee_no:
        xor rax, rax;                            // refuse output (exit 3)
        ret;
      }
    }

  // ============================================================================
  // audit_set_parent(parent_audit_id) -> u64
  //   rdi = parent_audit_id       (0 iff top-level; else the parent's
  //                                 audit_id — e.g. the shell's
  //                                 ShellCommandRecord id propagated
  //                                 to a child via the spawn hand-off)
  //   rax = AUDIT_OK              on success
  //       | AUDIT_ERR_STATE       if record_state != IDLE
  //
  // M3-002 entry point. Must be called AFTER AuditRecord::reset() and
  // BEFORE AuditClient::audit_begin — parent_audit_id is a property
  // of the audit's identity, not something a running audit can mutate.
  // The IDLE gate enforces this: once audit_begin transitions to
  // BEGUN, audit_set_parent is refused.
  //
  // The D3 audit-first contract requires every operation to be
  // discoverable in the audit graph; parent_audit_id is the D3
  // discipline handle for consumers — it lets a supervisor
  // reconstruct the per-shell-command tree from a flat audit stream
  // (shell writes its ShellCommandRecord with parent = 0, then
  // propagates its own audit_id to the child; the child sets it
  // here before its own audit_begin so all three of its lifecycle
  // events — INVOKE / OUTPUT / EXIT — carry the linkage).
  //
  // Consumers that never call audit_set_parent get parent = 0 in
  // their wire records via .bss zero-init (or reset()'s zero pass);
  // this is the correct behaviour for the shell itself, a
  // bootstrap tool spawned outside a shell, or any tool that has
  // no parent audit context.
  //
  // How the parent_audit_id reaches the child is out of scope for
  // libpdx-audit — the shell publishes its command-record id via
  // its spawn protocol (env var, InitCap sidecar entry, or a
  // typed-frame field on the child's stdin depending on which
  // shell.M3 lands first). This library only exposes the setter.
  //
  // Pure leaf; no callee-save touched, no nested call.
  // ============================================================================

  pub let audit_set_parent : (u64) -> u64 !{mem} @{} =
    fn (parent_audit_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-audit.M3-002: audit_set_parent entry point. Gate: record_state must be AUDIT_STATE_IDLE (0); on any other state return AUDIT_ERR_STATE (1) — parent linkage is a property of the audit's identity and cannot be mutated mid-flight. On IDLE, store rdi (parent_audit_id) into record_parent_audit_id via `lea r11,[rip+record_parent_audit_id]; mov [r11],rdi` per the parser.pdx cross-module-write pattern; return AUDIT_OK (0). Pure leaf — no push/pop, no nested call. Register plan: rax = state-load / return, r11 = LEA scratch, rdi = parent_audit_id argument (stored directly). Effects `!{mem} @{}` — pure .bss read/write, no syscall, no cap. Immediates: 0 (state gate + AUDIT_OK), 1 (AUDIT_ERR_STATE) — within paideia-as cmp-imm bounds. No test mnemonic; every zero-check is cmp reg, 0. Label prefix asp_ per project_paideiaos reserved-label discipline (labels using bare 'ok'/'fail' collide with keywords; asp_ok / asp_bad_state are unique).",
      block: {
        // ---- Gate: record_state must be IDLE (0) ---------------------
        lea r11, [rip + record_state];
        mov rax, [r11];
        cmp rax, 0;                              // AUDIT_STATE_IDLE
        jne asp_bad_state;

        // ---- Store parent_audit_id from rdi. -------------------------
        lea r11, [rip + record_parent_audit_id];
        mov [r11], rdi;

        xor rax, rax;                            // AUDIT_OK
        ret;

      asp_bad_state:
        mov rax, 1;                              // AUDIT_ERR_STATE
        ret;
      }
    }
}
