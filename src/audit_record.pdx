// src/audit_record.pdx — libpdx-audit.M1-001
// AuditRecord: singleton .bss storage for one active audit record.
// See design/architecture.md §2–§4 for layout rationale, storage
// model, and the state machine consumers observe.
// Upstream: design/tooling/r49-r50-plan.md §3.4 + §5.13 (paideia-os).

module AuditRecord = structure {

  // --- Error codes (0 = OK). Consumers pattern-match on these. ---------
  pub let AUDIT_OK                     : u64 = 0
  pub let AUDIT_ERR_STATE              : u64 = 1   // state-machine gate violated
  pub let AUDIT_ERR_ID_MISMATCH        : u64 = 2   // audit_id != record_audit_id
  pub let AUDIT_ERR_BROKER_UNAVAILABLE : u64 = 3   // svc_lookup miss / cap-table full
  pub let AUDIT_ERR_SEND_FAILED        : u64 = 4   // sys_ipc_send non-zero return
  pub let AUDIT_ERR_HASH_INACTIVE      : u64 = 5   // audit_hash_update without prior audit_hash_init (M3-001)

  // --- State machine values written to record_state. --------------------
  pub let AUDIT_STATE_IDLE      : u64 = 0
  pub let AUDIT_STATE_BEGUN     : u64 = 1
  pub let AUDIT_STATE_OUTPUT    : u64 = 2
  pub let AUDIT_STATE_COMMITTED : u64 = 3

  // --- Broker-slot sentinel. 0xFFFF is outside every valid cap slot
  //     ([0..255]) so a raw eq/ne comparison discriminates cleanly. ------
  pub let AUDIT_BROKER_SLOT_UNRESOLVED : u64 = 0xFFFF

  // --- Wire format sizes (see design/architecture.md §2). --------------
  // M3-002 upgrade: payload grows from 56 to 64 bytes (seven → eight
  // u64 words) to carry record_parent_audit_id at payload index [7].
  // AUDIT_HDR_WORD's payload_len field (top 16 bits of the low half,
  // little-endian: bits [16..31] of the low 32) moves 0x38 → 0x40 to
  // match. The kernel-side audit_journal_broker_dispatch stub
  // (paideia-os src/kernel/core/ipc/audit_journal_broker.pdx) returns
  // AJB_DISPATCH_STUB without validating the payload shape, so the
  // grow is safe until the daemon body lands with a fixed schema.
  pub let AUDIT_PAYLOAD_BYTES : u64 = 64   // eight u64 words (M3-002)
  pub let AUDIT_HDR_WORD      : u64 = 0x0000004000000120  // op=0x20 | ver=1 | reply_ep=0 | payload_len=64

  // --- M3-001 FNV-1a-64 hash constants. Placeholder for the
  //     BLAKE3-truncated hash design/tooling/r49-r50-plan.md §5.13
  //     M3-001 specifies; the FNV-1a-64 primitive here swaps for
  //     BLAKE3 (truncated to first 8 bytes) once paideia-as exposes
  //     BLAKE3 as a stdlib intrinsic — the streaming API surface in
  //     AuditHash (init/update/finalize) and the record_hash_state
  //     .bss slot stay identical across that swap.
  //
  //     FNV_OFFSET_BASIS (0xcbf29ce484222325) exceeds the 0x7FFFFFFF
  //     cmp-imm bound but is legal for a register load: paideia-as
  //     encodes `mov r64, imm64` as MOVABS. Same for FNV_PRIME
  //     (0x100000001b3 — 41-bit value, needs MOVABS). Both constants
  //     are load-only; neither ever appears in a cmp instruction.
  pub let FNV_OFFSET_BASIS : u64 = 0xcbf29ce484222325
  pub let FNV_PRIME        : u64 = 0x100000001b3

  // --- M2-001 lifecycle event kinds. Written at payload index [1] by
  //     AuditBroker::audit_send_record so a supervisor replay can
  //     discriminate the three phases of a single audit.
  //
  //     UEJ_KIND_TOOL_INVOKE (130) matches the kernel-side ordinal at
  //     src/kernel/core/ipc/audit_journal_broker.pdx in paideia-os.
  //     OUTPUT (132) and EXIT (133) are forward-declared here pending
  //     the R49-PREP-007 kernel-side ordinal split (see plan.md §5.13
  //     "libpdx-audit.M2 also depends on the R49-PREP-006 event
  //     constants splitting into UEJ_KIND_TOOL_INVOKE/OUTPUT/EXIT ...
  //     the split is deferred to R49-PREP-007"). The daemon body is
  //     still stubbed (audit_journal_broker_dispatch returns
  //     AJB_DISPATCH_STUB) so transport-layer sys_ipc_send does not
  //     validate the event_kind field; when R49-PREP-007 lands the
  //     ordinals here reconcile with kernel-side by matching value. -----
  pub let UEJ_KIND_TOOL_INVOKE : u64 = 130
  pub let UEJ_KIND_TOOL_OUTPUT : u64 = 132
  pub let UEJ_KIND_TOOL_EXIT   : u64 = 133

  // --- Singleton storage (bootstrap-scope; M3-002 migrates to caller-
  //     owned when nested audits arrive). --------------------------------
  //
  // Every slot is `uninit` because .bss is zero-initialised at load time;
  // AUDIT_STATE_IDLE (=0), record_audit_id (=0, the "no audit" sentinel),
  // audit_id_next (=0, lazy-initialised to 1 by audit_begin on first
  // call), audit_broker_slot (=0, then reset() writes UNRESOLVED once at
  // consumer boot) — all rely on that zeroing.

  pub let mut audit_id_next            : u64 = uninit @align(8)
  pub let mut record_audit_id          : u64 = uninit @align(8)
  pub let mut record_op_name_ptr       : u64 = uninit @align(8)
  pub let mut record_op_args_ptr       : u64 = uninit @align(8)
  pub let mut record_output_schema_ptr : u64 = uninit @align(8)
  pub let mut record_output_hash       : u64 = uninit @align(8)
  pub let mut record_exit_code         : u64 = uninit @align(8)
  pub let mut record_state             : u64 = uninit @align(8)
  pub let mut audit_broker_slot        : u64 = uninit @align(8)

  // M3-002 parent-child linkage slot. Written by
  // AuditClient::audit_set_parent BEFORE audit_begin; 0 means
  // top-level (no parent, e.g. the shell itself or a bootstrap tool
  // spawned outside a shell context). AuditBroker::audit_send_record
  // marshals this at payload index [7] on every INVOKE/OUTPUT/EXIT
  // so a supervisor replaying the audit journal can reconstruct the
  // per-shell-command tree: shell writes its own ShellCommandRecord
  // (parent = 0), then propagates its audit_id to the child via the
  // spawn hand-off, and the child sets it here before its own
  // audit_begin. .bss zero-init means the M2 shape (no linkage)
  // remains the default — consumers that never call audit_set_parent
  // get parent = 0 in their wire records.
  pub let mut record_parent_audit_id   : u64 = uninit @align(8)

  // M2-002 sticky failure flag. Written to 1 the first time any send
  // path (audit_begin's INVOKE, audit_record_output's OUTPUT, or
  // audit_commit's EXIT) fails; consumers read it via
  // AuditClient::audit_can_emit_output() to gate every stdout/stderr
  // write per D3 audit-first (I4). Once set, only reset() clears it —
  // there is no in-flight recovery path in M2. .bss zero-initialised
  // (0 = healthy, 1 = failed).
  pub let mut audit_broker_failed      : u64 = uninit @align(8)

  // M3-001 streaming-hash accumulator slots. Feed the tool's output
  // stream into AuditHash::audit_hash_update as it is emitted;
  // audit_hash_finalize reads record_hash_state and returns the
  // truncated u64 the consumer passes to audit_record_output.
  //
  // record_hash_state — FNV-1a-64 accumulator (or the truncated
  //   BLAKE3-256 first-8-bytes when the primitive swaps in). .bss
  //   zero-init; audit_hash_init writes FNV_OFFSET_BASIS to seed.
  // record_hash_active — 1 while an accumulation is in flight; 0
  //   before init or after finalize. audit_hash_update refuses to
  //   run when 0 (returns AUDIT_ERR_HASH_INACTIVE) so a caller
  //   that forgets to init does not silently fold bytes into the
  //   zero baseline.
  pub let mut record_hash_state        : u64 = uninit @align(8)
  pub let mut record_hash_active       : u64 = uninit @align(8)

  // --- Send-time payload scratch. `.bss` again; 64 bytes = one wire
  //     record at M3-002 (grew from 56 to 64 to carry parent_audit_id
  //     at index [7]). audit_send_record memcpy-fills this before
  //     sys_ipc_send. Sized in u64 words so paideia-as encodes it as
  //     an aligned array rather than a byte blob. --------------------
  pub let mut audit_payload_scratch : [u64; 8] = uninit @align(8)
  pub let mut audit_hdr_scratch     : u64      = uninit @align(8)

  // reset() — bootstrap init. Clears the in-progress record and
  // primes audit_id_next / audit_broker_slot to their sentinel values.
  // Consumers call this ONCE at process start (typical: right after
  // libpdx-argv's ParsedArgs::reset() at _start), not between audits —
  // audit_id_next must remain monotonic across audits within a process.
  pub let reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-audit.M1-001 + M1-002 + M2-002 + M3-001 + M3-002: zero the in-progress bookkeeping slots so a fresh audit_begin starts from a known-idle state, then seed audit_id_next=1 (so the first handed-out id is 1, leaving 0 as the reserved 'no audit' sentinel) and audit_broker_slot=AUDIT_BROKER_SLOT_UNRESOLVED (0xFFFF). M2-002 adds audit_broker_failed to the zero pass so a re-init after a failed audit gets a clean slate. M3-001 adds record_hash_state + record_hash_active to the zero pass so a fresh reset() gives audit_hash_init a clean starting point (rather than inheriting a hash-in-flight from a prior audit within the same process). M3-002 adds record_parent_audit_id to the zero pass so a consumer that never calls audit_set_parent gets parent = 0 (top-level) in its wire records, preserving the M2 shape. r11 is scratch (paideia-as conformance). rax=0 is the value written into each zero slot; xor rax,rax is one byte cheaper than mov rax,0 and produces the same result. The two sentinel writes are separate mov rax,imm; mov [r11],rax pairs so the immediates stay ≤ 0x7FFFFFFF (both do: 1 and 0xFFFF are 32-bit-safe). Leaf function — no callee-save touched, no push/pop.",
      block: {
        xor rax, rax;                                    // rax = 0
        lea r11, [rip + record_audit_id];          mov [r11], rax;
        lea r11, [rip + record_op_name_ptr];       mov [r11], rax;
        lea r11, [rip + record_op_args_ptr];       mov [r11], rax;
        lea r11, [rip + record_output_schema_ptr]; mov [r11], rax;
        lea r11, [rip + record_output_hash];       mov [r11], rax;
        lea r11, [rip + record_exit_code];         mov [r11], rax;
        lea r11, [rip + record_state];             mov [r11], rax;
        lea r11, [rip + audit_broker_failed];      mov [r11], rax;
        lea r11, [rip + record_hash_state];        mov [r11], rax;
        lea r11, [rip + record_hash_active];       mov [r11], rax;
        lea r11, [rip + record_parent_audit_id];   mov [r11], rax;

        mov rax, 1;                                      // audit_id_next = 1
        lea r11, [rip + audit_id_next];            mov [r11], rax;

        mov rax, 0xFFFF;                                 // audit_broker_slot = UNRESOLVED
        lea r11, [rip + audit_broker_slot];        mov [r11], rax;
        ret;
      }
    }
}
