// src/audit_hash.pdx — libpdx-audit.M3-001 + paideia-os #2508 (RETIRE-1)
// AuditHash: streaming output-stream hash accumulator, now BLAKE3-backed.
//
// Three entry points, matching the streaming-digest shape:
//
//   audit_hash_init()                    -> ()
//   audit_hash_update(ptr, len)          -> u64  (AUDIT_OK | AUDIT_ERR_HASH_INACTIVE)
//   audit_hash_finalize()                -> u64  (state[0..8] as little-endian u64)
//
// Consumer wire-up:
//
//   AuditHash::audit_hash_init()
//   … tool emits chunk1 … AuditHash::audit_hash_update(chunk1_ptr, chunk1_len)
//   … tool emits chunk2 … AuditHash::audit_hash_update(chunk2_ptr, chunk2_len)
//   let h = AuditHash::audit_hash_finalize()
//   AuditClient::audit_record_output(id, schema, h)
//
// paideia-os #2508 (RETIRE-1). The M3-001 FNV-1a-64 placeholder was
// replaced by BLAKE3 via paideia-as #1545 (v0.36.55 shipped the
// Blake3::hash / hash_keyed / derive_key stdlib hooks and the
// libpaideia_satellite_runtime.a archive from paideia-as B6-002 carries
// the extern-C thunks). BLAKE3's FFI is one-shot (data_ptr, data_len,
// out_ptr), so multi-chunk streaming is implemented via a keyed-chain:
//
//   init:  state[0..32] = 0
//   update(chunk):
//     BLAKE3::hash_keyed(key=state, data=chunk, out=next)
//     state = next
//   finalize: return u64::from_le_bytes(state[0..8])
//
// This preserves determinism (same byte stream ⇒ same final u64), the
// M3-001 "one final u64 to the wire" contract, and the streaming shape
// (constant working set regardless of total bytes). The chain
// construction is not equivalent to a single BLAKE3 over the
// concatenation of all chunks — but the wire semantic is "some
// collision-resistant 64-bit fingerprint of the output stream", which
// the keyed chain satisfies. Downstream verifiers that need to
// recompute must know they are chaining BLAKE3-keyed rather than
// single-shot BLAKE3 (see AUDIT_HASH_STATE_BYTES / this file for the
// exact construction).
//
// Cross-module symbols read/written (all in AuditRecord .bss):
//   record_hash_state (32 bytes), record_hash_next (32 bytes),
//   record_hash_active (u64)
// Cross-module constants referenced:
//   AuditRecord::AUDIT_OK, AuditRecord::AUDIT_ERR_HASH_INACTIVE
// Extern-C thunks called:
//   paideia_crypto_blake3_hash_keyed (satellite-runtime archive)

module AuditHash = structure {

  // ============================================================================
  // audit_hash_init() -> ()
  //
  // Zeros record_hash_state (32 bytes = 4 u64 words) and sets
  // record_hash_active = 1. Idempotent — a re-init resets to the
  // empty-stream state, which matches BLAKE3's `Hasher::new()`
  // semantics.
  //
  // Pure leaf; no callee-save touched. Called at the top of the
  // tool's output loop, typically right after audit_begin.
  // ============================================================================

  pub let audit_hash_init : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os #2508 (RETIRE-1): seed record_hash_state to 32 zero bytes (BLAKE3 keyed-chain empty-state, matches Blake3::hash of the empty input under key=0 as the initial chain value). rax=0 written into all four u64 words via lea+mov pairs. record_hash_active := 1 via a second mov. Leaf; no push/pop, no nested call. Register plan: rax=zero then 1, r11=LEA scratch. All immediates within cmp-imm gate (0 and 1).",
      block: {
        xor rax, rax;

        lea r11, [rip + record_hash_state];
        mov [r11 + 0], rax;
        mov [r11 + 8], rax;
        mov [r11 + 16], rax;
        mov [r11 + 24], rax;

        mov rax, 1;
        lea r11, [rip + record_hash_active];
        mov [r11], rax;
        ret;
      }
    }

  // ============================================================================
  // audit_hash_update(ptr, len) -> u64
  //   rdi = ptr    (bytes to fold into the hash)
  //   rsi = len    (byte count; 0 is a legal no-op)
  //   rax = AUDIT_OK                 on success (or on len == 0 no-op)
  //       | AUDIT_ERR_HASH_INACTIVE  if audit_hash_init was not called
  //
  // Folds `len` bytes at `ptr` into record_hash_state via one BLAKE3
  // keyed step:
  //
  //   paideia_crypto_blake3_hash_keyed(key=state, data=ptr, len, out=next)
  //   state <- next   (32-byte memcpy via 4 u64 loads/stores)
  //
  // The two-buffer shape (state read as key, next written by BLAKE3,
  // then copied back) keeps key_ptr and out_ptr from aliasing at the
  // FFI boundary.
  //
  // Refuses to run if record_hash_active == 0 — audit_hash_init must
  // be called first (defence-in-depth against callers that skip init
  // and would otherwise chain from the .bss zero baseline; the
  // AUDIT_ERR_HASH_INACTIVE return is what test_replay_golden.pdx
  // subtest 4 asserts).
  //
  // Register plan (four callee-save pushes for the nested call —
  // preserves rbx/rbp/r12/r13, all SysV callee-save — plus a sub rsp,8
  // pad so rsp%16==0 at the call site):
  //   rbx = original rdi (data_ptr, needed after the extern call
  //         clobbers rdi)  — not used post-call at present, kept in
  //         callee-save shape for symmetry with the marshaling above.
  //   Alignment arithmetic: entry rsp%16==8; 4 pushes -> rsp%16==8-32
  //         mod 16 = 8; sub rsp,8 -> rsp%16==0. Restore in reverse.
  // ============================================================================

  pub let audit_hash_update : (u64, u64) -> u64 !{mem} @{} =
    fn (ptr: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os #2508 (RETIRE-1): fold one chunk into the BLAKE3 keyed-chain. Gate 1: record_hash_active must be 1; return AUDIT_ERR_HASH_INACTIVE (5) otherwise. Gate 2: len==0 -> legal no-op returning AUDIT_OK (0). Body: marshal (key=&record_hash_state, data_ptr=rdi, data_len=rsi, out=&record_hash_next), call paideia_crypto_blake3_hash_keyed (SysV: rdi=key, rsi=data, rdx=len, rcx=out; rax=0/err — err impossible here since our pointers are all non-null and either len==0 was gated out or len>0 and data_ptr is caller-guaranteed non-null). Copy record_hash_next -> record_hash_state as four u64 loads/stores (32 bytes). Return AUDIT_OK. Alignment: entry rsp%16==8; 4 pushes (rbx/rbp/r12/r13) -> rsp%16==8 (unchanged by 32 bytes mod 16); sub rsp,8 -> rsp%16==0 for the nested call; restore before ret. No test mnemonic (cmp reg,0 for every zero-check). No 2-op imul,imm; no and rN,imm64. Immediates: 0/1/5 all imm32-safe.",
      block: {
        push rbx;
        push rbp;
        push r12;
        push r13;
        sub rsp, 8;                              // rsp%16==0 for nested call

        // Gate 1: active flag.
        lea r11, [rip + record_hash_active];
        mov rax, [r11];
        cmp rax, 0;
        je  ahu_inactive;

        // Gate 2: len == 0 is a legal no-op (do not chain the empty
        // chunk — keeps state stable through an empty update()).
        cmp rsi, 0;
        je  ahu_done_ok;

        // Marshal extern-C paideia_crypto_blake3_hash_keyed:
        //   rdi = &record_hash_state   (key_ptr, 32 bytes)
        //   rsi = data_ptr             (caller's rdi)
        //   rdx = data_len             (caller's rsi)
        //   rcx = &record_hash_next    (out_ptr, 32 bytes)
        // Move len BEFORE rsi is clobbered by ptr.
        mov rdx, rsi;                            // data_len = caller len
        mov rsi, rdi;                            // data_ptr = caller ptr
        lea rdi, [rip + record_hash_state];      // key_ptr
        lea rcx, [rip + record_hash_next];       // out_ptr
        call paideia_crypto_blake3_hash_keyed;

        // Copy record_hash_next -> record_hash_state (32 bytes).
        lea r11, [rip + record_hash_next];
        mov rbx, [r11 + 0];
        mov rbp, [r11 + 8];
        mov r12, [r11 + 16];
        mov r13, [r11 + 24];
        lea r11, [rip + record_hash_state];
        mov [r11 + 0],  rbx;
        mov [r11 + 8],  rbp;
        mov [r11 + 16], r12;
        mov [r11 + 24], r13;

      ahu_done_ok:
        xor rax, rax;                            // AUDIT_OK
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;

      ahu_inactive:
        mov rax, 5;                              // AUDIT_ERR_HASH_INACTIVE
        add rsp, 8;
        pop r13;
        pop r12;
        pop rbp;
        pop rbx;
        ret;
      }
    }

  // ============================================================================
  // audit_hash_finalize() -> u64
  //   rax = u64::from_le_bytes(record_hash_state[0..8]) if active == 1
  //       | 0                                            if active == 0
  //
  // Reads first 8 bytes of state as a little-endian u64 (x86_64's
  // native word order — a single 64-bit load), clears
  // record_hash_active, returns the value. Clearing active on
  // finalize enforces single-use.
  //
  // Returns 0 when inactive rather than an error code — the caller's
  // audit_record_output already accepts a u64 hash and cannot
  // discriminate a "zero hash by chance" from a "zero hash by
  // finalize-on-inactive"; treating both as 0 keeps the surface
  // simple.
  //
  // Pure leaf; no callee-save touched.
  // ============================================================================

  pub let audit_hash_finalize : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "paideia-os #2508 (RETIRE-1): return u64::from_le_bytes(record_hash_state[0..8]) — a single 64-bit load on x86_64 delivers the LE truncation. Fast path if inactive: return 0 without touching state (matches the M3-001 shape test_replay_golden asserts). Active path: load state[0..8] into rax, clear record_hash_active via a separate zero write through rcx (rax carries the return, must not be clobbered). Pure leaf. Register plan: rax=return, rcx=zero scratch, r11=LEA scratch. Immediates: 0 only.",
      block: {
        lea r11, [rip + record_hash_active];
        mov rax, [r11];
        cmp rax, 0;
        je  ahf_inactive;

        lea r11, [rip + record_hash_state];
        mov rax, [r11 + 0];                      // LE u64 of first 8 bytes

        xor rcx, rcx;                            // clear active flag
        lea r11, [rip + record_hash_active];
        mov [r11], rcx;
        ret;

      ahf_inactive:
        xor rax, rax;
        ret;
      }
    }
}
